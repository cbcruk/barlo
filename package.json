{
  "name": "barlo",
  "version": "0.3.1",
  "description": "Build desktop apps with Bun and the local Chrome. A port of GoogleChromeLabs/carlo.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cbcruk/barlo.git"
  },
  "homepage": "https://github.com/cbcruk/barlo#readme",
  "bugs": {
    "url": "https://github.com/cbcruk/barlo/issues"
  },
  "keywords": [
    "bun",
    "chrome",
    "desktop",
    "carlo",
    "cdp",
    "webview"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "module": "./src/index.ts",
  "sideEffects": false,
  "engines": {
    "bun": ">=1.3.12"
  },
  "files": [
    "src",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "docs:check": "bun scripts/doccheck.ts",
    "example": "bun examples/systeminfo/main.ts",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "better-result": "^3.0.1"
  }
}
